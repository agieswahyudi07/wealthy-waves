---

---

<section
  id="contact"
  class="py-24 px-6 bg-gradient-to-b from-[#0a0a0c] to-[#121316] relative overflow-hidden"
>
  <!-- Glowing accent element in background -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-yellow-500/5 rounded-full blur-[120px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <h2
        class="text-3xl md:text-5xl font-display font-extrabold text-yellow-500 mb-4"
      >
        Hubungi Kami
      </h2>
      <p class="text-white/60 max-w-2xl mx-auto">
        Diskusikan proyek kreatif, rekaman musik, atau kebutuhan penyewaan motor
        operasional Anda di Bali bersama kami.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Left Column: Info & WhatsApp CTA -->
      <div class="space-y-8">
        <h3 class="text-2xl font-bold text-white mb-6">
          Mulai Kolaborasi Anda
        </h3>
        <p class="text-white/70 leading-relaxed">
          Wealthy Waves Group siap membantu mewujudkan visi kreatif Anda,
          menyediakan sarana transportasi yang andal, dan memproduksi karya
          audio-visual berstandar profesional. Hubungi kami melalui formulir di
          samping, atau hubungi kami langsung secara instan melalui WhatsApp.
        </p>

        <!-- Contact Details -->
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 bg-yellow-500/10 rounded-2xl flex items-center justify-center text-yellow-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <p
                class="text-xs text-white/40 font-semibold tracking-wider uppercase"
              >
                Kantor Operasional
              </p>
              <p class="text-white font-medium">Bali, Indonesia</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-yellow-500/10 rounded-2xl flex items-center justify-center text-yellow-500 shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
            </div>
            <div>
              <p
                class="text-xs text-white/40 font-semibold tracking-wider uppercase mb-2"
              >
                Telepon / WhatsApp
              </p>
              <div class="text-white text-sm font-medium flex flex-col gap-1.5">
                <span>Wealthy Rent Bike: 08112285113</span>
                <span>Wealthy Legacy: 0895421900396</span>
                <span>Wealthy Record: 089613121385</span>
                <span>Wealthy Pawnshop: 08112285113</span>
                <span>Bali Brezee: 085718534036</span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 bg-yellow-500/10 rounded-2xl flex items-center justify-center text-yellow-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <p
                class="text-xs text-white/40 font-semibold tracking-wider uppercase"
              >
                Email Korespondensi
              </p>
              <p class="text-white font-medium">mail@gmail.com</p>
            </div>
          </div>
        </div>

        <div class="pt-4">
          <a
            id="wa-cta-button"
            href="https://wa.me/628112285113"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-full transition-all shadow-lg hover:shadow-emerald-500/20 duration-300 cursor-pointer"
          >
            <!-- WhatsApp Custom SVG -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="currentColor"
              class="bi bi-whatsapp"
              viewBox="0 0 16 16"
            >
              <path
                d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.93a7.904 7.904 0 0 0 1.08 3.861L0 16l4.223-1.108a7.893 7.893 0 0 0 3.769 1.025h.007c4.367 0 7.926-3.558 7.93-7.93a7.897 7.897 0 0 0-2.322-5.596zM10.82 11.233c-.22.115-.436.195-.658.261-.22.065-.436.098-.65.098-.553 0-1.116-.217-1.637-.638a10.63 10.63 0 0 1-2.316-2.316c-.42-.52-.638-1.084-.638-1.637 0-.214.033-.43.098-.65.066-.222.146-.438.26-.658l.195-.39c.066-.13.11-.26.11-.39v-.26c0-.13-.043-.26-.13-.39L5.35 3.393c-.11-.22-.26-.39-.456-.39h-.39c-.195 0-.39.066-.585.195a2.76 2.76 0 0 0-.978 1.433c-.156.456-.234.912-.234 1.368 0 .847.24 1.748.718 2.574a12.012 12.012 0 0 0 4.14 4.14c.826.478 1.727.718 2.574.718.456 0 .912-.078 1.368-.234a2.76 2.76 0 0 0 1.433-.978c.13-.195.195-.39.195-.585v-.39c0-.195-.17-.346-.39-.456l-1.629-.815z"
              ></path>
            </svg>
            Chat langsung via WhatsApp
          </a>
        </div>
      </div>

      <!-- Right Column: Glassmorphism Contact Form -->
      <form
        class="glass-card p-8 md:p-12 rounded-[2.5rem] space-y-6 w-full relative"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="name" class="text-sm font-semibold text-white/70"
              >Nama Lengkap</label
            >
            <input
              type="text"
              id="name"
              required
              placeholder="Masukkan nama Anda"
              class="w-full px-5 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:border-yellow-500 focus:bg-white/10 transition-colors"
            />
          </div>
          <div class="space-y-2">
            <label for="email" class="text-sm font-semibold text-white/70"
              >Email</label
            >
            <input
              type="email"
              id="email"
              required
              placeholder="nama@email.com"
              class="w-full px-5 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:border-yellow-500 focus:bg-white/10 transition-colors"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="division" class="text-sm font-semibold text-white/70"
            >Kebutuhan Divisi</label
          >
          <select
            id="division"
            class="w-full px-5 py-4 bg-[#151619] border border-white/10 rounded-2xl text-white focus:outline-none focus:border-yellow-500 transition-colors cursor-pointer"
          >
            <option value="rent-bike" class="bg-[#151619] text-white">Wealthy Rent Bike</option>
            <option value="legacy" class="bg-[#151619] text-white">Wealthy Legacy</option>
            <option value="record" class="bg-[#151619] text-white">Wealthy Record</option>
            <option value="pawnshop" class="bg-[#151619] text-white">Wealthy Pawnshop</option>
            <option value="bali-brezee" class="bg-[#151619] text-white">Bali Brezee</option>
            <option value="general" class="bg-[#151619] text-white">Pertanyaan Umum / Kolaborasi Lain</option>
          </select>
        </div>

        <!-- Phone Field (Added after Division) -->
        <div class="space-y-2">
          <label for="phone" class="text-sm font-semibold text-white/70"
            >Nomor Telepon / WhatsApp</label
          >
          <input
            type="tel"
            id="phone"
            required
            placeholder="Contoh: 08968122921"
            class="w-full px-5 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:border-yellow-500 focus:bg-white/10 transition-colors"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="text-sm font-semibold text-white/70"
            >Pesan Anda</label
          >
          <textarea
            id="message"
            rows="5"
            required
            placeholder="Tuliskan pesan detail tentang kebutuhan Anda..."
            class="w-full px-5 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-white/20 focus:outline-none focus:border-yellow-500 focus:bg-white/10 transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Status Notification Box -->
        <div
          id="form-status"
          class="hidden p-4 rounded-2xl text-sm font-semibold text-center"
        >
        </div>

        <button
          type="submit"
          class="w-full py-4 bg-yellow-500 hover:bg-yellow-400 text-black font-extrabold rounded-2xl transition-all shadow-lg hover:shadow-yellow-500/25 duration-300 cursor-pointer"
        >
          Kirim Pesan Sekarang
        </button>
      </form>
    </div>
  </div>
</section>

// Lead Collector JavaScript
<script>
  // MASUKKAN URL GOOGLE APPS SCRIPT WEB APP ANDA DI SINI
  const SHEET_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbyhQKyIdAGDzTtWZJmjZBwdWaoEhWHtyDhjpKP9U-FUw3Oa-YYLEC0gIl2bIUgJe-lzoA/exec";

  const form = document.querySelector("#contact form") as HTMLFormElement;
  const statusBox = document.getElementById("form-status");
  const submitBtn = form?.querySelector(
    'button[type="submit"]',
  ) as HTMLButtonElement;
  const divisionSelect = document.getElementById("division") as HTMLSelectElement;
  const waButton = document.getElementById("wa-cta-button") as HTMLAnchorElement;

  const waNumbers: Record<string, string> = {
    "rent-bike": "628112285113",
    "legacy": "62895421900396",
    "record": "6289613121385",
    "pawnshop": "628112285113",
    "bali-brezee": "6285718534036",
    "general": "628112285113"
  };

  if (divisionSelect && waButton) {
    divisionSelect.addEventListener("change", (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      const number = waNumbers[selected] || "628112285113";
      waButton.href = `https://wa.me/${number}`;
    });
  }

  if (form && statusBox && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!SHEET_SCRIPT_URL) {
        statusBox.textContent =
          "Harap isi variabel SHEET_SCRIPT_URL di dalam file ContactCTA.astro terlebih dahulu.";
        statusBox.className =
          "p-4 rounded-2xl text-sm font-semibold text-center bg-yellow-500/10 border border-yellow-500/20 text-yellow-500 block";
        return;
      }

      // Ambil nilai input
      const nameVal = (document.getElementById("name") as HTMLInputElement).value;
      const emailVal = (document.getElementById("email") as HTMLInputElement).value;
      const divisionVal = (document.getElementById("division") as HTMLSelectElement).value;
      const divisionText = divisionSelect.options[divisionSelect.selectedIndex].text;
      const phoneVal = (document.getElementById("phone") as HTMLInputElement).value;
      const messageVal = (document.getElementById("message") as HTMLTextAreaElement).value;

      // Status loading
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-75", "cursor-wait");
      const originalText = submitBtn.textContent;
      submitBtn.innerHTML = `<span class="flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5 text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Mengirim pesan...</span>`;
      statusBox.classList.add("hidden");

      // Timeout untuk ganti teks loading
      const slowRequestTimeout = setTimeout(() => {
        submitBtn.innerHTML = `<span class="flex items-center justify-center gap-2"><svg class="animate-spin h-5 w-5 text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memproses... (mohon tunggu)</span>`;
      }, 5000);

      // Abort controller untuk membatalkan jika terlalu lama (15 detik)
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 15000);

      try {
        await fetch(SHEET_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: {
            "Content-Type": "text/plain;charset=utf-8",
          },
          body: JSON.stringify({
            name: nameVal,
            email: emailVal,
            division: divisionVal,
            phone: phoneVal,
            message: messageVal,
          }),
          signal: controller.signal
        });

        clearTimeout(slowRequestTimeout);
        clearTimeout(timeoutId);

        statusBox.textContent = "Terima kasih! Pesan Anda telah berhasil terkirim.";
        statusBox.className = "p-4 rounded-2xl text-sm font-semibold text-center bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 block";
        form.reset();
        
      } catch (err) {
        clearTimeout(slowRequestTimeout);
        clearTimeout(timeoutId);
        
        // Fallback Ultimate UX: Langsung arahkan ke WhatsApp dengan form yang sudah diisi!
        statusBox.textContent = "Sistem sedang sibuk. Kami sedang mengarahkan Anda ke WhatsApp untuk melanjutkan...";
        statusBox.className = "p-4 rounded-2xl text-sm font-semibold text-center bg-yellow-500/10 border border-yellow-500/20 text-yellow-500 block";
        
        const number = waNumbers[divisionVal] || "628112285113";
        const waText = `Halo Wealthy Waves,\nSaya ingin menghubungi terkait *${divisionText}*.\n\n*Detail Kontak:*\nNama: ${nameVal}\nEmail: ${emailVal}\nTelepon: ${phoneVal}\n\n*Pesan:*\n${messageVal}`;
        
        setTimeout(() => {
          window.open(`https://wa.me/${number}?text=${encodeURIComponent(waText)}`, '_blank');
          statusBox.textContent = "Gagal via sistem, namun diarahkan ke WhatsApp.";
        }, 2000);
        
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-75", "cursor-wait");
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
