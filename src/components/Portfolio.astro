---
import { Image } from "astro:assets";
import imgBaliBreeze from "../assets/showcase/bali-breeze-image.jpeg";
import imgLegacy from "../assets/showcase/walthy-legacy-image.jpeg";
import imgCleanBike from "../assets/showcase/wealthy-clean-bike-bali-image.jpeg";
import imgRecords from "../assets/showcase/wealthy-records-image.jpeg";
import imgRentBike from "../assets/showcase/wealthy-rent-bike-image.jpeg";

const portfolioItems = [
  {
    id: "01",
    category: "RENT BIKE",
    title: "Wealthy Rent Bike",
    image: imgRentBike,
  },
  {
    id: "02",
    category: "RECORDS",
    title: "Wealthy Records",
    image: imgRecords,
  },
  {
    id: "03",
    category: "LEGACY",
    title: "Wealthy Legacy",
    image: imgLegacy,
  },
  {
    id: "04",
    category: "CLEAN BIKE",
    title: "Wealthy Clean Bike Bali",
    image: imgCleanBike,
  },
  {
    id: "05",
    category: "BALI BREEZE",
    title: "Bali Breeze",
    image: imgBaliBreeze,
  },
];
---

<section
  id="portfolio"
  class="py-24 px-6 bg-gradient-to-b from-[#0a0a0c] to-[#0e0f11] relative overflow-hidden"
>
  <!-- Decorative background glow -->
  <div
    class="absolute top-1/2 left-0 w-[500px] h-[500px] bg-yellow-500/5 rounded-full blur-[120px] pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2
        class="text-xs uppercase tracking-[0.2em] text-yellow-500 font-semibold mb-3 font-display"
      >
        Showcase
      </h2>
      <p class="text-3xl md:text-5xl font-display font-extrabold text-white">
        Video Portfolio & Galeri Karya
      </p>
    </div>

    <!-- Featured Video Portfolio (YouTube Embed) -->
    <div
      class="glass-card p-4 md:p-8 rounded-[2.5rem] border border-white/5 mb-16 max-w-5xl mx-auto"
    >
      <div
        class="aspect-video w-full overflow-hidden rounded-[1.5rem] shadow-2xl relative bg-black border border-white/5"
      >
        <iframe
          src="https://www.youtube.com/embed/rE46xr7CH74"
          title="Wealthy Waves Video Portfolio"
          class="w-full h-full absolute inset-0 border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen></iframe>
      </div>
      <div class="mt-6 text-center max-w-2xl mx-auto">
        <span
          class="text-xs font-bold text-yellow-500 tracking-wider uppercase font-display block mb-1"
          >Featured Video Project</span
        >
        <h3 class="text-lg font-bold text-white mb-2">
          Video Profil & Promosi Kreatif
        </h3>
        <p class="text-white/60 text-sm">
          Saksikan cuplikan video sinematik garapan kami yang merepresentasikan
          standar visual tinggi dari divisi Wealthy Legacy.
        </p>
      </div>
    </div>

    <!-- Other Portfolio Items -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        portfolioItems.map((item) => (
          <div class="group relative rounded-3xl overflow-hidden aspect-video cursor-pointer transition-transform duration-300 hover:scale-[1.02] border border-white/5 shadow-lg">
            <Image
              src={item.image}
              width={800}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              alt={item.title}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80" />
            <div class="absolute bottom-0 left-0 p-8">
              <span class="text-yellow-500 text-xs font-bold tracking-widest mb-2 block font-display">
                {item.id} {item.category}
              </span>
              <h3 class="text-xl font-bold text-white">{item.title}</h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
