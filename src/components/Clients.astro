---
import { Image } from "astro:assets";

import logoCatCafe from "../assets/clients/logo-ultimate-cat-cafe.webp";
import logoResidence from "../assets/clients/logo-ultimate-residence.webp";
import logoKutaDental from "../assets/clients/logo-kuta-dental.webp";
import logoAlBayt from "../assets/clients/logo-al-bayt-hitam.webp";
import logoKana88 from "../assets/clients/logo-kana88.webp";
import logoKookoPaw from "../assets/clients/logo-kookopaw.webp";
import logoZaitun from "../assets/clients/logo-arabian-food-zaitun.webp";
import logoAyamGeprek from "../assets/clients/logo-geprek-nenek.webp";
import logoBaliBeach from "../assets/clients/logo-bali-beach-glamping.webp";

const clients = [
  { name: "Ultimate Cat Cafe", logo: logoCatCafe, initial: "UC" },
  { name: "Ultimate Residence", logo: logoResidence, initial: "UR" },
  { name: "Kuta Dental", logo: logoKutaDental, initial: "KD" },
  { name: "Al Bayt Restaurant", logo: logoAlBayt, initial: "AB" },
  { name: "Kana88 Bali", logo: logoKana88, initial: "K8" },
  { name: "Kooko Paw", logo: logoKookoPaw, initial: "KP" },
  { name: "Zaitun Arabian Food", logo: logoZaitun, initial: "ZF" },
  { name: "Ayam Geprek Nenek", logo: logoAyamGeprek, initial: "AG" },
  { name: "Bali Beach Glamping", logo: logoBaliBeach, initial: "BB" }
];
---

<section class="py-24 px-6 bg-gradient-to-b from-[#0a0a0c] to-[#0e0f11] relative overflow-hidden">
  <!-- Decorative background glow -->
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-yellow-500/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-xs uppercase tracking-[0.2em] text-yellow-500 font-semibold mb-3 font-display">Kolaborasi & Kemitraan</h2>
      <p class="text-3xl md:text-4xl font-display font-extrabold text-white leading-tight">Klien yang Mempercayai Kami</p>
    </div>
    
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 items-stretch justify-center">
      {clients.map((client, index) => {
        const delayClass = index % 5 > 0 ? `delay-${(index % 5) * 100}` : '';
        return (
        <div class={`glass-card p-6 rounded-2xl flex flex-col items-center justify-center gap-3 border border-white/5 hover:border-yellow-500/30 transition-all duration-500 group relative h-full min-h-[12rem] magnetic-card reveal ${delayClass}`}>
          {/* Background glowing effect */}
          <div class="absolute inset-0 bg-gradient-to-br from-yellow-500/0 to-yellow-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          
          <!-- Logo Image Slot / Text Fallback -->
          <div class="relative w-24 h-24 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-500 p-3">
            <Image 
              src={client.logo} 
              alt={client.name} 
              width={96}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-contain relative z-10 transition-opacity duration-300 opacity-80 group-hover:opacity-100"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
            />
            {/* Styled initial fallback */}
            <span class="text-yellow-500 font-bold text-sm tracking-wide font-display absolute hidden">{client.initial}</span>
          </div>

          <span class="text-xs font-semibold text-white/80 group-hover:text-white transition-colors duration-300 text-center line-clamp-2">
            {client.name}
          </span>
        </div>
        )
      })}
    </div>
  </div>
</section>
