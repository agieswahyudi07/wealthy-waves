---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const jobs = [
  {
    title: "Creative Video Editor",
    division: "Wealthy Legacy",
    location: "Bali / Remote",
    type: "Full-Time",
  },
  {
    title: "Sound Engineer Assistant",
    division: "Wealthy Records",
    location: "Bali",
    type: "Full-Time",
  },
  {
    title: "Customer Service & Operations Officer",
    division: "Wealthy Rent Bike",
    location: "Bali",
    type: "Full-Time",
  },
];
---

<Layout
  title="Career - Wealthy Waves Group"
  description="Bergabunglah bersama kami di Wealthy Waves Group untuk berinovasi dan tumbuh bersama di Bali."
>
  <Navbar />

  <main class="pt-40 pb-24">
    <section class="max-w-4xl mx-auto px-6 text-center mb-16 animate-fade-in">
      <span
        class="text-yellow-500 uppercase tracking-widest text-xs font-bold block mb-4 font-display"
        >Karir</span
      >
      <h1
        class="text-4xl md:text-6xl font-display font-extrabold text-white mb-6"
      >
        Tumbuh Bersama Kami
      </h1>
      <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
        Kami selalu mencari individu berbakat, kreatif, dan berdedikasi tinggi
        untuk menjadi bagian dari keluarga besar Wealthy Waves Group.
      </p>
    </section>

    <!-- Open Positions -->
    <section class="max-w-4xl mx-auto px-6 space-y-6">
      <h2 class="text-2xl font-bold text-yellow-500 mb-8 font-display">
        Lowongan Terbuka
      </h2>

      {
        jobs.map((job) => (
          <div class="glass-card p-6 md:p-8 rounded-3xl flex flex-col md:flex-row md:items-center justify-between gap-6 hover:scale-[1.01] transition-transform duration-300">
            <div>
              <span class="text-xs font-semibold text-yellow-500/80 uppercase tracking-wider block mb-2">
                {job.division}
              </span>
              <h3 class="text-xl font-bold text-white mb-2">{job.title}</h3>
              <div class="flex flex-wrap gap-4 text-sm text-white/50">
                <span class="flex items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  {job.location}
                </span>
                <span class="flex items-center gap-1">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="14" x="2" y="7" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                  {job.type}
                </span>
              </div>
            </div>
            <div>
              <a
                href="/#contact"
                class="inline-block px-6 py-3 bg-yellow-500 hover:bg-yellow-400 text-black font-bold rounded-2xl text-sm transition-colors text-center cursor-pointer"
              >
                Lamar Pekerjaan
              </a>
            </div>
          </div>
        ))
      }
    </section>
  </main>

  <Footer />
</Layout>
