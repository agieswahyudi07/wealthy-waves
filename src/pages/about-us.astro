---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Advantages from '../components/Advantages.astro';
import Footer from '../components/Footer.astro';

const management = [
  { name: "Divi", role: "Direktur Utama", image: "/images/team/divi.webp", initial: "D" },
  { name: "Louis Keaton Armandio", role: "Wakil Direktur Utama", image: "/images/team/louis-keaton.webp", initial: "LA" },
  { name: "Ibnu Borneo", role: "Komisaris", image: "/images/team/ibnu-borneo.webp", initial: "IB" },
  { name: "Jendral Yoga", role: "Komisaris", image: "/images/team/jendral-yoga.webp", initial: "JY" },
];

const journey = [
  {
    year: "2021",
    title: "Membangun Kemitraan",
    description: "Berhasil menjalin kerjasama dengan beberapa perusahaan besar yang memperkuat posisi kami di pasar. Kami juga mulai melakukan inovasi dalam produk untuk memenuhi kebutuhan konsumen."
  },
  {
    year: "2023",
    title: "Ekspansi Pasar",
    description: "Meluncurkan produk baru yang telah diterima dengan baik di pasar internasional. Tindakan ini menandai langkah besar dalam strategi ekspansi global kami."
  },
  {
    year: "2023",
    title: "Inovasi Berkelanjutan",
    description: "Memperkenalkan teknologi baru yang meningkatkan efisiensi operasional dan kepuasan pelanggan. Kami berkomitmen untuk terus berinovasi dalam setiap aspek bisnis."
  },
  {
    year: "2024",
    title: "Komitmen terhadap Keberlanjutan",
    description: "Mengimplementasikan inisiatif ramah lingkungan dalam semua proses bisnis. Kami percaya bahwa keberlanjutan adalah kunci untuk masa depan yang lebih baik."
  },
  {
    year: "2025",
    title: "Penghargaan Bergengsi",
    description: "Pada 10 Mei 2025, kami telah menerima penghargaan dari asosiasi industri atas pencapaian kami dalam kualitas layanan. Ini merupakan pengakuan atas dedikasi tim kami dalam memberikan yang terbaik."
  }
];
---

<Layout title="About Us - Wealthy Waves Group" description="Membangun ekosistem kreatif masa depan di Bali yang mengintegrasikan layanan mobilitas, label musik, dan video branding.">
  <Navbar />
  
  <main class="pt-40">
    <!-- Hero / Intro -->
    <section class="pb-20 px-6 text-center max-w-5xl mx-auto animate-fade-in">
      <span class="text-white/80 font-bold block mb-4 font-display text-lg reveal">About Us</span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-yellow-500 mb-6 reveal delay-100">Unified Ecosystem of Mobility, Creativity & Branding</h1>
      <p class="text-white/60 text-sm md:text-base leading-relaxed max-w-3xl mx-auto reveal delay-200">
        Hadir sebagai platform terpadu untuk layanan mobilisasi, produksi kreatif, dan manajemen branding.
      </p>
    </section>

    <!-- Visi Misi Section -->
    <section class="py-24 px-6 bg-white/5 border-y border-white/5">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="glass-card p-10 rounded-[2.5rem] transition-transform duration-300 hover:scale-[1.01] reveal">
          <div class="flex items-center justify-between border-b border-white/5 pb-6 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-[#151619] border border-white/10 flex items-center justify-center text-white/50">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            </div>
            <h2 class="text-xl font-bold text-white font-display uppercase tracking-wider">Visi</h2>
          </div>
          <p class="text-white/70 leading-relaxed text-sm">
            Menjadi grup usaha dan investasi yang berkelanjutan, terpercaya, dan berdampak nyata bagi pertumbuhan ekonomi kreatif dan UMKM.
          </p>
        </div>
        <div class="glass-card p-10 rounded-[2.5rem] transition-transform duration-300 hover:scale-[1.01] reveal delay-100">
          <div class="flex items-center justify-between border-b border-white/5 pb-6 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-[#151619] border border-white/10 flex items-center justify-center text-white/50">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <h2 class="text-xl font-bold text-white font-display uppercase tracking-wider">Misi</h2>
          </div>
          <ul class="space-y-4 text-white/70 text-sm">
            <li class="flex gap-3">
              <span class="text-white font-bold font-display">1.</span>
              Mengelola unit bisnis secara profesional dan terstruktur
            </li>
            <li class="flex gap-3">
              <span class="text-white font-bold font-display">2.</span>
              Membangun ekosistem usaha lintas sektor yang saling mendukung
            </li>
            <li class="flex gap-3">
              <span class="text-white font-bold font-display">3.</span>
              Mendukung UMKM dan pebisnis inovatif melalui pendanaan berbasis syariah
            </li>
            <li class="flex gap-3">
              <span class="text-white font-bold font-display">4.</span>
              Menghasilkan produk, layanan, dan investasi bernilai jangka panjang
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Struktur Organisasi / Board of Directors -->
    <section class="py-24 px-6 relative overflow-hidden">
      <!-- Glow background -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-yellow-500/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center mb-16 reveal">
          <h2 class="text-3xl md:text-4xl font-display font-extrabold text-yellow-500 mb-3">Our Team</h2>
          <p class="text-white/60">Temukan tim hebat di balik karya-karya kami.</p>
        </div>

        <div class="flex flex-wrap justify-center gap-6">
          {management.map((member, index) => {
            const delayClass = index % 5 > 0 ? `delay-${(index % 5) * 100}` : '';
            return (
            <div class={`glass-card p-5 w-[45%] sm:w-[30%] lg:w-[18%] rounded-2xl text-left border border-white/5 hover:border-yellow-500/30 transition-all duration-300 group magnetic-card reveal ${delayClass}`}>
              <!-- Avatar Slot -->
              <div class="relative w-full aspect-square mb-4 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center overflow-hidden group-hover:scale-105 group-hover:border-yellow-500/30 transition-all duration-300">
                <img 
                  src={member.image} 
                  alt={member.name} 
                  width="300"
                  height="300"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover relative z-10 transition-transform duration-500 group-hover:scale-110"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                />
                <span class="text-2xl font-bold text-yellow-500 tracking-wide font-display absolute hidden">{member.initial}</span>
              </div>
              <p class="text-xs text-white/80 font-medium tracking-wide mb-1">{member.role}</p>
              <h3 class="text-sm font-bold text-white leading-tight line-clamp-1">{member.name}</h3>
            </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- Our Journey Section -->
    <section class="py-24 px-6 relative overflow-hidden">
      <div class="max-w-4xl mx-auto relative z-10 glass-card p-8 md:p-16 rounded-[2.5rem] reveal">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-display font-extrabold text-yellow-500 mb-3">Our Journey</h2>
          <p class="text-white/60">Perjalanan yang membentuk identitas dan karya kami.</p>
        </div>

        <div class="relative border-l-2 border-white/10 ml-4 md:ml-32 space-y-12">
          {journey.map((item, index) => {
            const delayClass = index % 5 > 0 ? `delay-${(index % 5) * 100}` : '';
            return (
              <div class={`relative pl-8 md:pl-16 reveal ${delayClass}`}>
                <!-- Year Box -->
                <div class="absolute -left-[4.5rem] md:-left-32 top-0 bg-[#151619] border border-white/10 text-white font-bold px-4 py-2 rounded-xl text-sm md:text-base w-24 text-center hidden md:block">
                  {item.year}
                </div>
                <!-- Mobile Year Tag -->
                <div class="md:hidden inline-block bg-[#151619] border border-white/10 text-white font-bold px-3 py-1 rounded-lg text-xs mb-3">
                  {item.year}
                </div>
                <!-- Connector Line (horizontal) -->
                <div class="absolute -left-0 top-5 w-8 md:w-16 border-t-2 border-white/10"></div>
                <!-- Dot -->
                <div class="absolute -left-1.5 top-3.5 w-3 h-3 bg-yellow-500 rounded-full shadow-[0_0_10px_rgba(234,179,8,0.5)]"></div>
                
                <!-- Content -->
                <div>
                  <h3 class="text-lg md:text-xl font-bold text-white mb-2">{item.title}</h3>
                  <p class="text-white/60 text-sm leading-relaxed">{item.description}</p>
                </div>
              </div>
            )
          })}
        </div>
      </div>
    </section>

    <!-- Advantages Component -->
    <Advantages />
  </main>

  <Footer />
</Layout>
