---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const posts = [
  {
    title: "Tips Terbaik Keliling Bali Menggunakan Motor Sewaan",
    date: "15 Mei 2026",
    category: "PARIWISATA",
    excerpt: "Cara aman dan nyaman menjelajahi keindahan tersembunyi pulau Bali dengan mengendarai skuter matik premium.",
    image: "https://picsum.photos/seed/bali-trip/600/400"
  },
  {
    title: "Bagaimana Audio Yang Tepat Dapat Meningkatkan Nilai Brand Anda",
    date: "10 Mei 2026",
    category: "BRANDING",
    excerpt: "Pentingnya jingle komersial dan sound design yang disesuaikan dalam video promosi untuk menarik perhatian pemirsa.",
    image: "https://picsum.photos/seed/audio-brand/600/400"
  },
  {
    title: "Panduan Membuat Video Cinematic Yang Menarik Perhatian",
    date: "02 Mei 2026",
    category: "VIDEO PRODUCTION",
    excerpt: "Teknik pencahayaan, framing, dan penyuntingan cerita (storytelling) untuk menghasilkan video promosi produk yang profesional.",
    image: "https://picsum.photos/seed/video-tips/600/400"
  }
];
---

<Layout title="Blog - Wealthy Waves Group" description="Dapatkan tips perjalanan, wawasan produksi audio-visual, dan tren branding terkini dari blog Wealthy Waves Group.">
  <Navbar />

  <main class="pt-40 pb-24">
    <section class="max-w-4xl mx-auto px-6 text-center mb-16 animate-fade-in">
      <span class="text-yellow-500 uppercase tracking-widest text-xs font-bold block mb-4 font-display">Blog & Artikel</span>
      <h1 class="text-4xl md:text-6xl font-display font-extrabold text-white mb-6">Wawasan & Inspirasi</h1>
      <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
        Kumpulan cerita dari lapangan, tips praktis, dan tren industri kreatif yang ditulis oleh tim ahli kami.
      </p>
    </section>

    <!-- Blog Grid -->
    <section class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="bg-[#151619] rounded-3xl overflow-hidden border border-white/5 flex flex-col hover:scale-[1.02] transition-transform duration-300">
            <img src={post.image} class="w-full h-48 object-cover" alt={post.title} />
            <div class="p-6 md:p-8 flex-1 flex flex-col">
              <div class="flex items-center justify-between text-xs font-bold text-yellow-500 uppercase mb-4 tracking-widest">
                <span>{post.category}</span>
                <span class="text-white/40">{post.date}</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-3 hover:text-yellow-500 transition-colors cursor-pointer leading-snug">
                {post.title}
              </h3>
              <p class="text-white/60 text-sm leading-relaxed mb-6 flex-1">
                {post.excerpt}
              </p>
              <a href="#" class="inline-flex items-center gap-2 text-sm font-bold text-yellow-500 hover:text-yellow-400 transition-colors">
                Baca Selengkapnya
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
